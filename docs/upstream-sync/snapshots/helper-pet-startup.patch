diff --git a/tests/test_component_application_startup.py b/tests/test_component_application_startup.py
new file mode 100644
index 0000000000000000000000000000000000000000..c65c9901b722e590655c69e6ce91b8cf2d055af7
--- /dev/null
+++ b/tests/test_component_application_startup.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+import json
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from components.operations import launch_catalog_component, start_enabled_catalog_components
+from components import configuration
+
+
+class PetLifecycleTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.row = {
+            "component_id": "octoppet", "name": "Paldee Pet", "required_capabilities": [],
+            "platform_supported": True,
+            "settings": [{"key": "start_with_helper", "value_type": "boolean"}],
+            "installation": {"status": "installed", "launchable": True,
+                "path": str(self.root), "entry": str(self.root / "paldee-pet.exe"),
+                "protocol": "octoppet-component@1", "version": "0.2.2"},
+        }
+        self.value = {"protocol": "octoppet-component@1", "id": "octoppet", "version": "0.2.2",
+                      "ok": True, "running": True, "pid": 123}
+
+    def result(self, value=None, code=0):
+        return subprocess.CompletedProcess([], code, stdout=json.dumps(value or self.value), stderr="")
+
+    def test_open_uses_start_and_show_fixed_json_commands(self):
+        with patch("components.operations.component_row", return_value=self.row), patch("subprocess.run", return_value=self.result()) as run:
+            result = launch_catalog_component("octoppet")
+        self.assertEqual(result["pid"], 123)
+        self.assertEqual([call.args[0][1] for call in run.call_args_list], ["start", "show"])
+        self.assertEqual(run.call_args.args[0][0], str(self.root / "paldee-pet.exe"))
+        self.assertNotIn("shell", run.call_args.kwargs)
+        self.assertEqual(run.call_args.kwargs["timeout"], 17)
+
+    def test_background_start_does_not_show_hidden_existing_pet(self):
+        with patch("components.operations.component_row", return_value=self.row), patch("subprocess.run", return_value=self.result()) as run:
+            launch_catalog_component("octoppet", show=False)
+        self.assertEqual(run.call_count, 1)
+        self.assertEqual(run.call_args.args[0][1], "start")
+
+    def test_failure_is_reported_and_show_is_not_called(self):
+        value = dict(self.value, ok=False, error={"message": "WebView2 unavailable"})
+        with patch("components.operations.component_row", return_value=self.row), patch("subprocess.run", return_value=self.result(value, 6)) as run:
+            with self.assertRaisesRegex(ValueError, "WebView2 unavailable"):
+                launch_catalog_component("octoppet")
+        self.assertEqual(run.call_count, 1)
+
+    def test_wrong_protocol_and_version_are_rejected(self):
+        for key in ["protocol", "version", "id"]:
+            with self.subTest(key=key), patch("components.operations.component_row", return_value=self.row), patch("subprocess.run", return_value=self.result(dict(self.value, **{key: "wrong"}))):
+                with self.assertRaisesRegex(ValueError, "不匹配"):
+                    launch_catalog_component("octoppet")
+
+    def test_timeout_does_not_freeze_caller_indefinitely(self):
+        with patch("components.operations.component_row", return_value=self.row), patch("subprocess.run", side_effect=subprocess.TimeoutExpired("pet", 17)):
+            with self.assertRaisesRegex(ValueError, "超时"):
+                launch_catalog_component("octoppet")
+
+    def test_no_opt_in_means_no_start_and_no_config_write(self):
+        with patch("components.operations.component_rows", return_value=(self.row,)), patch.object(configuration, "SETTINGS_ROOT", self.root / "settings"), patch("components.operations.launch_catalog_component") as launch:
+            self.assertEqual(start_enabled_catalog_components(), ())
+        launch.assert_not_called()
+        self.assertFalse((self.root / "settings").exists())
+
+    def test_saved_opt_in_starts_once_without_forcing_show(self):
+        with patch.object(configuration, "SETTINGS_ROOT", self.root):
+            (self.root / "octoppet.json").write_text('{"start_with_helper": true}', encoding="utf-8")
+            with patch("components.operations.component_rows", return_value=(self.row,)), patch("components.operations.launch_catalog_component") as launch:
+                result = start_enabled_catalog_components()
+        launch.assert_called_once_with("octoppet", manager=None, show=False)
+        self.assertEqual(result[0]["error"], "")
+
+    def test_disabled_or_corrupt_saved_preference_never_starts(self):
+        for content in ['{"start_with_helper": false}', '{"start_with_helper": "true"}', 'invalid']:
+            with self.subTest(content=content), patch.object(configuration, "SETTINGS_ROOT", self.root):
+                (self.root / "octoppet.json").write_text(content, encoding="utf-8")
+                with patch("components.operations.component_rows", return_value=(self.row,)), patch("components.operations.launch_catalog_component") as launch:
+                    self.assertEqual(start_enabled_catalog_components(), ())
+                launch.assert_not_called()
+
+    def test_uninstalled_unsupported_and_non_application_are_skipped(self):
+        for change in [{"platform_supported": False}, {"settings": []}, {"installation": dict(self.row["installation"], status="not_installed")}, {"installation": dict(self.row["installation"], launchable=False)}]:
+            with self.subTest(change=change), patch("components.operations.component_rows", return_value=(dict(self.row, **change),)), patch("components.operations.launch_catalog_component") as launch:
+                self.assertEqual(start_enabled_catalog_components(), ())
+            launch.assert_not_called()
+
+    def test_startup_failure_does_not_abort_other_components(self):
+        other = dict(self.row, component_id="another-pet", name="Other")
+        with patch("components.operations.component_rows", return_value=(self.row, other)), patch.object(configuration, "stored_component_setting", return_value=True), patch("components.operations.launch_catalog_component", side_effect=[ValueError("missing runtime"), {"pid": 1}]):
+            result = start_enabled_catalog_components()
+        self.assertEqual(result[0]["error"], "missing runtime")
+        self.assertEqual(result[1]["error"], "")
+
+    def test_setting_uses_existing_validated_store_and_survives_version_change(self):
+        definitions = configuration.component_setting_definitions([{
+            "key": "start_with_helper", "name": "随“屏幕自动化小助手”启动", "value_type": "boolean", "default": False,
+        }])
+        with patch.object(configuration, "SETTINGS_ROOT", self.root), patch.object(configuration, "_installed_definitions", return_value=definitions):
+            self.assertFalse(configuration.component_configuration("octoppet")["values"]["start_with_helper"])
+            saved = configuration.save_component_configuration("octoppet", {"start_with_helper": True})
+            self.assertTrue(saved["values"]["start_with_helper"])
+            self.assertFalse(saved["restart_required"])
+            self.assertTrue(configuration.component_configuration("octoppet")["values"]["start_with_helper"])
+
+
+if __name__ == "__main__":
+    unittest.main()
