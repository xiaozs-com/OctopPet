+def start_enabled_catalog_components(
+    manager: ComponentManager | None = None,
+) -> tuple[dict[str, Any], ...]:
+    """Use local verified catalog only; start applications explicitly opted in by the user."""
+    from .configuration import stored_component_setting
+
+    results = []
+    for row in component_rows(manager):
+        installation = row.get("installation") or {}
+        if installation.get("status") != "installed" or not installation.get("launchable") or not row.get("platform_supported"):
+            continue
+        if not any(item.get("key") == "start_with_helper" and item.get("value_type") == "boolean" for item in row.get("settings") or ()):
+            continue
+        component_id = row["component_id"]
+        if stored_component_setting(component_id, "start_with_helper", False) is not True:
+            continue
+        try:
+            launch_catalog_component(component_id, manager=manager, show=False)
+            results.append({"component_id": component_id, "name": row["name"], "error": ""})
+        except Exception as exc:
+            results.append({"component_id": component_id, "name": row["name"], "error": str(exc)})
+    return tuple(results)
