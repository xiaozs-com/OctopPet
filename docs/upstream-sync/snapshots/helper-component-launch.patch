diff --git a/tests/test_component_application_launch.py b/tests/test_component_application_launch.py
new file mode 100644
--- /dev/null
+++ b/tests/test_component_application_launch.py
@@ -0,0 +1,52 @@
+from __future__ import annotations
+
+import tempfile
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+from components.operations import launch_catalog_component
+
+
+class ComponentApplicationLaunchTests(unittest.TestCase):
+    def row(self, root, *, launchable=True):
+        return {"component_id": "pd-device-bridge", "required_capabilities": [],
+                "installation": {"status": "installed", "launchable": launchable,
+                                 "path": str(root), "entry": str(root / "OctopPet.exe")}}
+
+    @patch("components.operations.component_row")
+    @patch("subprocess.Popen")
+    def test_launches_fixed_entry_without_shell(self, spawn, row):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            row.return_value = self.row(root)
+            spawn.return_value.pid = 123
+            with patch("os.name", "nt"):
+                result = launch_catalog_component("pd-device-bridge")
+            self.assertEqual(result["pid"], 123)
+            self.assertEqual(spawn.call_args.args[0], [str(root / "OctopPet.exe")])
+            self.assertNotIn("shell", spawn.call_args.kwargs)
+
+    @patch("components.operations.component_row")
+    @patch("subprocess.Popen")
+    def test_non_application_cannot_be_opened(self, spawn, row):
+        row.return_value = self.row(Path("."), launchable=False)
+        with self.assertRaisesRegex(ValueError, "应用入口"):
+            launch_catalog_component("pd-device-bridge")
+        spawn.assert_not_called()
+
+    @patch("components.operations.component_row")
+    @patch("subprocess.Popen")
+    def test_entry_cannot_escape_component_directory(self, spawn, row):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary) / "component"
+            value = self.row(root)
+            value["installation"]["entry"] = str(root.parent / "unrelated.exe")
+            row.return_value = value
+            with self.assertRaises(ValueError):
+                launch_catalog_component("pd-device-bridge")
+        spawn.assert_not_called()
+
+
+if __name__ == "__main__":
+    unittest.main()
