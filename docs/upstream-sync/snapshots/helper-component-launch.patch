 ) -> dict[str, Any]:
     component_definition(component_id)
     return save_component_configuration(component_id, values)
+
+
+def launch_catalog_component(component_id: str, *, manager: ComponentManager | None = None) -> dict[str, Any]:
+    """Open a verified installed application entry without shell interpretation."""
+    import os
+    import subprocess
+
+    row = component_row(component_id, manager)
+    _require_component_capabilities(row)
+    installed = row.get("installation") or {}
+    if installed.get("status") != "installed" or not installed.get("launchable"):
+        raise ValueError("该组件没有可打开的应用入口")
+    root = Path(installed["path"]).resolve()
+    entry = Path(installed["entry"]).resolve()
+    entry.relative_to(root)
+    if os.name != "nt" or entry.suffix.casefold() != ".exe":
+        raise ValueError("当前仅支持 Windows 应用组件")
+    process = subprocess.Popen(
+        [str(entry)], cwd=root, stdin=subprocess.DEVNULL,
+        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
+        creationflags=getattr(subprocess, "CREATE_NO_WINDOW", 0),
+    )
+    return {"component_id": component_id, "pid": process.pid}
