#!/usr/bin/env bash
# Pre-commit gate: make all (format-all + lint + typecheck + test).
# Enable once per clone:  make install-hooks
# Bypass (emergency only): SKIP_PRECOMMIT=1 git commit …
# Or: git commit --no-verify
set -euo pipefail

if [[ "${SKIP_PRECOMMIT:-}" == "1" ]]; then
  echo "[pre-commit] SKIP_PRECOMMIT=1 — skipping checks"
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR || true)

echo "[pre-commit] make all  (format-all + lint + typecheck + test)"
if command -v make >/dev/null 2>&1; then
  make all
elif [[ "${OS:-}" == "Windows_NT" ]] && command -v powershell.exe >/dev/null 2>&1; then
  echo "[pre-commit] Windows equivalent: scripts/check-windows.ps1"
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check-windows.ps1
else
  echo "[pre-commit] make is required on this platform" >&2
  exit 1
fi

if ((${#STAGED_FILES[@]} > 0)); then
  existing=()
  for f in "${STAGED_FILES[@]}"; do
    if [[ -e "$f" || -L "$f" ]]; then
      existing+=("$f")
    fi
  done
  if ((${#existing[@]} > 0)); then
    git add -- "${existing[@]}"
  fi
fi

echo "[pre-commit] all checks passed"
